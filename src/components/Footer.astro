---
import { site } from '../data/site';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container inner">
    <span>© {year} {site.fullName}</span>
    <span>{site.location}</span>
  </div>
</footer>

<style>
  .footer {
    padding-block: 24px;
    border-top: 1px solid var(--line);
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 14px;
    color: var(--muted);
  }
</style>
