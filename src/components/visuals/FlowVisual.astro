---
import type { FlowStep } from '../../data/site';

interface Props {
  steps: FlowStep[];
}
const { steps } = Astro.props;

const icons: Record<FlowStep['icon'], string> = {
  mail: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/>',
  ai: '<path d="M12 3v3M12 18v3M3 12h3M18 12h3"/><circle cx="12" cy="12" r="4"/>',
  shield: '<path d="M12 3l8 3v6c0 4.5-3.4 8.3-8 9-4.6-.7-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>',
  user: '<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>',
  check: '<path d="M5 12l5 5L20 7"/>',
};
---

<ol class="flow">
  {
    steps.map((s) => (
      <li class:list={['step', `icon-${s.icon}`, { highlight: s.highlight }]}>
        <span class="icon" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={icons[s.icon]} />
        </span>
        <span class="text">
          <strong>{s.title}</strong>
          <span>{s.detail}</span>
        </span>
      </li>
    ))
  }
</ol>

<style>
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .step {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    border-radius: 10px;
    background: var(--surface);
    box-shadow: 0 2px 8px rgba(14, 27, 44, 0.06);
  }
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -22px;
    width: 2px;
    height: 22px;
    background: #9fb0c8;
  }
  .icon {
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 8px;
    background: #eef1f6;
    color: var(--navy);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .text {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
  }
  .text strong {
    font-size: 15px;
  }
  .text span {
    font-size: 13px;
    color: var(--muted);
  }
  .highlight {
    background: var(--navy);
    color: #fff;
    box-shadow: none;
  }
  .highlight .icon {
    background: var(--accent);
    color: #fff;
  }
  .highlight .text span {
    color: var(--on-navy);
  }
  .icon-check .icon {
    background: #e3f2ea;
    color: var(--success);
  }
</style>
