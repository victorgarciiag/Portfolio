---
import { about, stack } from '../data/site';
---

<section id="sobre-mi" class="about">
  <div class="container inner">
    <div class="copy">
      <p class="eyebrow">Sobre mí</p>
      <h2 class="h2">{about.title}</h2>
      {about.paragraphs.map((p) => <p class="para">{p}</p>)}
    </div>

    <div class="side">
      <p class="side-title">Herramientas con las que trabajo</p>
      <dl class="stack">
        {
          stack.map((g) => (
            <div>
              <dt>{g.title}</dt>
              <dd>{g.items}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: 96px;
  }
  .inner {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: center;
  }
  .copy {
    flex: 1 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .para {
    color: var(--text);
    font-size: 17px;
  }
  .side {
    flex: 1 1 420px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .side-title {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .stack {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr));
    gap: 12px;
  }
  .stack div {
    padding: 18px 20px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--line);
  }
  dt {
    font-size: 13px;
    font-weight: 700;
    color: var(--accent);
  }
  dd {
    margin: 4px 0 0;
    font-size: 15px;
    color: var(--text);
  }
</style>
