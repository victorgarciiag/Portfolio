---
import { hero, site } from '../data/site';
---

<section id="inicio" class="hero">
  <div class="container hero-grid">
    <div class="copy">
      <p class="eyebrow">{hero.eyebrow}</p>
      <h1 class="title">
        {hero.title} <em>{hero.titleAccent}</em>
      </h1>
      <p class="intro">{hero.intro}</p>
      <div class="actions">
        <a class="btn btn-primary" href="#casos">Ver casos</a>
        <a class="btn btn-secondary" href="#contacto">Cuéntame tu proyecto</a>
      </div>
    </div>

    <div class="portrait">
      {
        hero.photo ? (
          <img class="photo" src={hero.photo} alt={`Foto de ${site.name}`} width="380" height="475" />
        ) : (
          <div class="photo placeholder" role="img" aria-label="Espacio para tu foto">
            [ Tu foto ]
          </div>
        )
      }
      <div class="now">
        <span class="now-label">Actualmente</span>
        <span class="now-text">{hero.now}</span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: 80px 96px;
  }
  .hero-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 64px;
    align-items: center;
  }
  .copy {
    flex: 1 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 26px;
  }
  .title {
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(40px, 5vw, 64px);
    line-height: 1.04;
    letter-spacing: -0.02em;
  }
  .title em {
    color: var(--accent);
  }
  .intro {
    max-width: 560px;
    font-size: 19px;
    color: var(--muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 4px;
  }
  .portrait {
    flex: 0 1 380px;
    min-width: 0;
    position: relative;
    padding-bottom: 36px;
  }
  .photo {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    object-fit: cover;
  }
  .placeholder {
    background: var(--subtle);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--muted);
    font-size: 14px;
  }
  .now {
    position: absolute;
    left: -28px;
    bottom: 0;
    max-width: 270px;
    padding: 16px 18px;
    border-radius: 12px;
    background: var(--surface);
    box-shadow: var(--shadow);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .now-label {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .now-text {
    font-size: 15px;
    font-weight: 600;
  }
  @media (max-width: 720px) {
    .now {
      left: 12px;
    }
  }
</style>
