---
import { site } from '../data/site';

const links = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#casos', label: 'Casos' },
  { href: '/#sobre-mi', label: 'Sobre mí' },
];
---

<header class="header">
  <nav class="container nav" aria-label="Principal">
    <a href="/" class="brand">
      <span class="brand-name">{site.name}</span>
      <span class="brand-tag">{site.tagline}</span>
    </a>
    <div class="links">
      {links.map((l) => <a class="link" href={l.href}>{l.label}</a>)}
      <button type="button" class="theme-toggle" data-theme-toggle aria-label="Activar modo noche">
        <svg class="icon-moon" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
        </svg>
        <svg class="icon-sun" aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
      </button>
      <a class="btn btn-primary cta" href="#contacto">Contactar</a>
    </div>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const button = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const media = matchMedia('(prefers-color-scheme: dark)');

  const apply = (theme: string) => {
    root.dataset.theme = theme;
    button?.setAttribute('aria-label', theme === 'dark' ? 'Activar modo día' : 'Activar modo noche');
  };
  const saved = () => {
    try {
      return localStorage.getItem('theme');
    } catch {
      return null;
    }
  };

  apply(root.dataset.theme ?? 'light');

  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    apply(next);
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  // Si el usuario no ha elegido nada, sigue los cambios del sistema
  media.addEventListener('change', (e) => {
    if (!saved()) apply(e.matches ? 'dark' : 'light');
  });
</script>

<style>
  .header {
    border-bottom: 1px solid var(--line);
  }
  .nav {
    padding-block: 20px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
    text-decoration: none;
    color: var(--ink);
  }
  .brand-name {
    font-family: var(--font-serif);
    font-weight: 600;
    font-size: 22px;
  }
  .brand-tag {
    font-size: 13px;
    color: var(--muted);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    font-size: 15px;
    font-weight: 500;
  }
  .link {
    color: var(--muted);
    text-decoration: none;
  }
  .link:hover {
    color: var(--ink);
  }
  .theme-toggle {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    color: var(--ink);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    transition: background 0.15s, border-color 0.15s;
  }
  .theme-toggle:hover {
    background: var(--hover);
  }
  .icon-sun,
  :global([data-theme='dark']) .icon-moon {
    display: none;
  }
  :global([data-theme='dark']) .icon-sun {
    display: block;
  }
  .cta {
    padding: 11px 20px;
  }
  @media (max-width: 560px) {
    .links {
      gap: 18px;
    }
    /* En móvil no cabe: el contacto ya está en la portada y al final */
    .cta {
      display: none;
    }
  }
</style>
