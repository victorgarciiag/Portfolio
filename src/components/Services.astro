---
import { services } from '../data/site';
---

<section id="servicios" class="services">
  <div class="container inner" data-tabs>
    <h2 class="h2">¿En qué te puedo ayudar?</h2>

    <div role="tablist" aria-label="Servicios" class="tabs">
      {
        services.map((s, i) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`tab-${s.id}`}
            aria-controls={`panel-${s.id}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            <span class="tab-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="tab-label">{s.label}</span>
          </button>
        ))
      }
    </div>

    {
      services.map((s, i) => (
        <div role="tabpanel" class="panel" id={`panel-${s.id}`} aria-labelledby={`tab-${s.id}`} hidden={i !== 0}>
          <div class="panel-copy">
            <p class="kicker">{s.kicker}</p>
            <p class="headline serif">{s.headline}</p>
            <p class="body">{s.body}</p>
            <a class="btn btn-light" href={s.ctaHref}>
              {s.cta}
            </a>
          </div>
          <div class="ideas">
            <p class="ideas-title">Ideas</p>
            <ul class="chips">
              {s.ideas.map((idea) => <li>{idea}</li>)}
            </ul>
            <a class="more" href="#contacto">
              ¿Tienes otra en mente? Cuéntamela →
            </a>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));

    const select = (tab: HTMLButtonElement) => {
      tabs.forEach((t) => {
        const on = t === tab;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !on;
      });
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab));
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const next = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        select(next);
        next.focus();
      });
    });
  });
</script>

<style>
  .services {
    padding-block: 88px;
    background: var(--navy);
    color: #fff;
  }
  .inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .tabs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    border-bottom: 1px solid var(--navy-line);
  }
  .tab {
    font: inherit;
    cursor: pointer;
    text-align: left;
    border: 0;
    background: transparent;
    padding: 18px 4px 20px;
    min-height: 44px;
    color: #9fb3d1;
    display: flex;
    align-items: baseline;
    gap: 12px;
    box-shadow: inset 0 -3px 0 transparent;
    transition: color 0.15s, box-shadow 0.15s;
  }
  .tab-num {
    font-size: 13px;
    font-weight: 600;
  }
  .tab-label {
    font-size: 19px;
    font-weight: 700;
  }
  .tab:hover {
    color: #fff;
  }
  .tab[aria-selected='true'] {
    color: #fff;
    box-shadow: inset 0 -3px 0 var(--accent-soft);
  }
  .tab[aria-selected='true'] .tab-num {
    color: var(--accent-soft);
  }
  .panel {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    padding: 40px;
    border-radius: var(--radius-lg);
    background: var(--navy-2);
  }
  .panel[hidden] {
    display: none;
  }
  .panel-copy {
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  .kicker {
    font-size: 14px;
    font-weight: 700;
    color: var(--accent-soft);
  }
  .headline {
    font-size: 32px;
    line-height: 1.2;
  }
  .body {
    color: var(--on-navy);
    font-size: 17px;
  }
  .panel-copy .btn {
    margin-top: 8px;
  }
  .ideas {
    flex: 1 1 400px;
    min-width: 0;
    display: flex;
    flex-direction: column;
  }
  .ideas-title {
    margin-bottom: 14px;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #9fb3d1;
    padding-bottom: 4px;
  }
  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .chips li {
    padding: 9px 14px;
    border-radius: 8px;
    border: 1px solid var(--navy-line);
    background: rgba(255, 255, 255, 0.04);
    font-size: 15px;
    font-weight: 500;
    color: #fff;
  }
  .more {
    margin-top: 18px;
    align-self: flex-start;
    color: var(--accent-soft);
    font-weight: 700;
    text-decoration: none;
  }
  .more:hover {
    color: #fff;
  }
  @media (max-width: 560px) {
    .panel {
      padding: 28px 20px;
    }
    .headline {
      font-size: 26px;
    }
  }
</style>
