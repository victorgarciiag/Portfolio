---
import { moreProjects } from '../data/site';
---

<section class="more container" aria-labelledby="more-title">
  <h3 id="more-title" class="title serif">Más proyectos</h3>
  <div class="list">
    {
      moreProjects.map((p) => (
        <details class="item" id={p.id}>
          <summary>
            <span class="name">{p.title}</span>
            <span class="meta">{p.meta}</span>
            <span class="sign" aria-hidden="true" />
          </summary>
          <div class="content">
            <p><strong>El reto.</strong> {p.challenge}</p>
            <p><strong>{p.solutionLabel ?? 'Lo que hice'}.</strong> {p.solution}</p>
            <p class="stack">{p.stack.join(' · ')}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>

<style>
  .more {
    padding-block: 56px 96px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .title {
    font-size: 28px;
  }
  .list {
    border-top: 1px solid var(--line-strong);
  }
  .item {
    border-bottom: 1px solid var(--line-strong);
  }
  summary {
    list-style: none;
    cursor: pointer;
    padding: 22px 12px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    transition: background 0.15s;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:hover {
    background: var(--subtle);
  }
  .name {
    flex: 1 1 340px;
    font-weight: 700;
    font-size: 18px;
  }
  .meta {
    flex: 0 1 260px;
    font-size: 14px;
    color: var(--muted);
  }
  .sign {
    flex: 0 0 24px;
    text-align: right;
    font-size: 22px;
    line-height: 1;
    color: var(--accent);
  }
  .sign::before {
    content: '+';
  }
  .item[open] .sign::before {
    content: '−';
  }
  .content {
    padding: 0 12px 26px;
    display: flex;
    flex-wrap: wrap;
    gap: 16px 40px;
    color: var(--text);
  }
  .content p {
    flex: 1 1 320px;
  }
  .content strong {
    color: var(--ink);
  }
  .content .stack {
    flex-basis: 100%;
    font-size: 14px;
    color: var(--muted);
  }
</style>
