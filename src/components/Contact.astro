---
import { contact, site } from '../data/site';
---

<section id="contacto" class="contact">
  <div class="container">
    <div class="box">
      <h2 class="title serif">{contact.title} <em>{contact.titleAccent}</em></h2>
      <p class="body">{contact.body}</p>
      <div class="actions">
        <a class="btn btn-light" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="btn btn-outline-light" href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="btn btn-outline-light" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="btn btn-outline-light" href={site.cv} download>Descargar CV</a>
      </div>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-bottom: 96px;
  }
  .box {
    padding: clamp(36px, 6vw, 72px);
    border-radius: 20px;
    background: var(--navy);
    color: #fff;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .title {
    max-width: 820px;
    font-size: clamp(36px, 4.8vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .title em {
    color: var(--accent-soft);
  }
  .body {
    max-width: 600px;
    color: var(--on-navy);
    font-size: 18px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-top: 8px;
  }
  .actions .btn {
    overflow-wrap: anywhere;
  }
</style>
